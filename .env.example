# ── OpenAI (Audio + Realtime — OpenAI 직통) ──
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1     # 기본값, 프록시 쓸 때만 지정

# ── 텍스트 LLM (OpenCode Go 직접 호출) ──
# OpenCode Go API 키. 비워두면 위 OPENAI_API_KEY 로 폴백.
OPENCODE_API_KEY=your-opencode-api-key
# OpenCode Go 엔드포인트
OPENAI_TEXT_BASE_URL=https://opencode.ai/zen/go/v1
# 사용할 모델 (gpt-5.6-luna, deepseek-v4-pro 등)
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Realtime (WebRTC ephemeral token) — OpenAI 직통
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# ── Tavily (웹 검색 tool use) ──
TAVILY_API_KEY=tvly-your-tavily-key

# ── PostgreSQL ──
# 필수: 값이 없으면 서버가 기동 실패합니다. 아래는 예시일 뿐 반드시 강력한 값으로 교체하세요.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tjkimdb
DB_USER=tjkim
DB_PASSWORD=change-me-to-a-strong-password

# ── JWT ──
# 필수: 값이 없으면 서버가 기동 실패합니다. 반드시 랜덤 문자열로 교체하세요 (예: openssl rand -hex 32).
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
