# AI API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
CLAUDE_API_KEY=sk-ant-api03-your-claude-api-key-here

# AI Center LLM Gateway (organize-diary / context-extract)
AICENTER_URL=https://llmgateway.azurewebsites.net/v1
AICENTER_API_KEY=sk-your-aicenter-api-key
AICENTER_MODEL=gemma4-26b-a4b

# Realtime provider 분기 ("openai" 또는 "azure")
REALTIME_PROVIDER=openai

# Azure OpenAI (Foundry) — REALTIME_PROVIDER=azure 일 때만 사용
# ENDPOINT는 호스트만 권장 (path/쿼리 붙어와도 코드가 알아서 잘라냄)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_OPENAI_KEY=<your-azure-key>
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-2

