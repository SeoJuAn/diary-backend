# ── OpenAI (Audio + Realtime — OpenAI 직통) ──
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1     # 기본값, 프록시 쓸 때만 지정

# ── 텍스트 LLM (opencode-router 프록시 경유) ──
# opencode-router의 API 키. 비워두면 위 OPENAI_API_KEY 로 폴백.
OPENCODE_API_KEY=your-opencode-api-key
# opencode-router 주소 (기본값: OpenCode Go 직접 호출)
OPENAI_TEXT_BASE_URL=https://opencode.ai/zen/go/v1
# opencode-router에서 사용할 모델 (gpt-5.6-luna, deepseek-v4-pro 등 19종)
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Realtime (WebRTC ephemeral token) — OpenAI 직통
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# ── Tavily (웹 검색 tool use) ──
TAVILY_API_KEY=tvly-your-tavily-key

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tjkimdb
DB_USER=tjkim
DB_PASSWORD=1111

# ── JWT ──
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
