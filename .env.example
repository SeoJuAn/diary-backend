# ── OpenAI (모든 LLM 호출의 단일 경로: 텍스트 / Realtime / STT / TTS) ──
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1     # 기본값, 프록시 쓸 때만 지정

# 텍스트 LLM (organize-diary / context-extract)
# GPT-5 계열은 temperature 미지원, max_completion_tokens 사용
OPENAI_TEXT_MODEL=gpt-5.6-terra
# none | low | medium | high | xhigh | max — 빈 값이면 파라미터 자체를 안 보냄
OPENAI_REASONING_EFFORT=none

# Realtime (WebRTC ephemeral token)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# ── Tavily (웹 검색 tool use) ──
TAVILY_API_KEY=tvly-your-tavily-key

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tjkimdb
DB_USER=tjkim
DB_PASSWORD=1111

# ── JWT ──
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
