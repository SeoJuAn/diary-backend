# AI API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
CLAUDE_API_KEY=sk-ant-api03-your-claude-api-key-here

# On-premise LLM Server (기본값이 설정되어 있으므로 선택사항)
ONPREMISE_LLM_URL=https://api.kpmgpoc-samsungfire.com/v1
ONPREMISE_LLM_MODEL=LFM2-2.6B-Exp-Q8_0.gguf

# Realtime provider 분기 ("openai" 또는 "azure")
REALTIME_PROVIDER=openai

# Azure OpenAI (Foundry) — REALTIME_PROVIDER=azure 일 때만 사용
# ENDPOINT는 호스트만 권장 (path/쿼리 붙어와도 코드가 알아서 잘라냄)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_OPENAI_KEY=<your-azure-key>
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-2

# Legacy
GPT_OSS_SERVER_URL=http://20.235.240.180:8080